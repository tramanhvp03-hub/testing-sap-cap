<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core">
    
    <Dialog
        id="addSaleOrderDialog"
        title="New Sale Order"
        contentWidth="800px"
        contentHeight="500px">
        
        <content>
            <VBox id="_IDGenVBox1" class="sapUiSmallMargin">
                <Label id="_IDGenLabel1" text="Customer Name" />
                <Input id="addCustomer" value="{createModel>/customerName}" valueLiveUpdate="true"/>

                <Label id="_IDGenLabel2" text="Order Date" class="sapUiSmallMarginTop" />
                <DatePicker 
                    id="addOrderDate" 
                    value="{createModel>/orderDate}"
                  valueFormat="yyyy-MM-dd" displayFormat="dd-MM-yyyy" />

                <Toolbar id="_IDGenToolbar" class="sapUiSmallMarginTop">
                    <Title id="_IDGenTitle4" text="Product List" />
                    <ToolbarSpacer id="_IDGenToolbarSpacer3" />
                    <Button id="_IDGenButton3" 
                        icon="sap-icon://add" 
                        press=".onAddProductRow" />
                </Toolbar>

                <Table id="addProductsTable" items="{createModel>/items}">
                    <columns>
                        <Column id="_IDGenColumn"><Text id="_IDGenText9" text="Product" /></Column>
                        <Column id="_IDGenColumn5"><Text id="_IDGenText10" text="Quantity" /></Column>
                        <Column id="_IDGenColumn7"><Text id="_IDGenText25" text="Price" /></Column>
                    </columns>
                    <items>
                        <ColumnListItem id="_IDGenColumnListItem3">
                            <cells>
                                <!-- ComboBox Product -->
                                <ComboBox id="_IDGenComboBox"
                                    selectedKey="{createModel>product_ID}"
                                    items="{path: '/Products', templateShareable: false}"
                                    selectionChange=".onProductChange">
                                    <core:ListItem id="_IDGenListItem1" key="{ID}" text="{name}" additionalText="{price}" />
                                </ComboBox>

                                <!-- Input Quantity -->
                                <Input id="_IDGenInput" value="{createModel>quantity}" type="Number" placeholder="Quantity" />

                                <!-- Input Price (Read-only để hiển thị giá) -->
                                <Input id="_IDGenInputPrice" value="{createModel>price}" editable="false" placeholder="Price" />

                                <!-- Nút Xóa dòng -->
                                <Button id="_IDGenButton9" icon="sap-icon://delete" type="Transparent" press=".onDeleteProductRow" />
                            </cells>
                        </ColumnListItem>
                    </items>
                </Table>
            </VBox>
        </content>

        <beginButton>
            <Button id="_IDGenButton4" 
                text="Save" 
                type="Emphasized" 
                press=".onSaveSaleOrder" />
        </beginButton>

        <endButton>
            <Button id="_IDGenButton8" 
                text="Cancel" 
                press=".onCloseAddDialog" />
        </endButton>
        
    </Dialog>
</core:FragmentDefinition>