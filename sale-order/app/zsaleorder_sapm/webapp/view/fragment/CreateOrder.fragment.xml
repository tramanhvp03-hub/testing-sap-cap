<core:FragmentDefinition 
    xmlns="sap.m" 
    xmlns:core="sap.ui.core" 
    xmlns:f="sap.ui.layout.form">
    
    <Dialog id="_IDGenDialog" title="Tạo Đơn Hàng Mới" icon="sap-icon://add" contentWidth="400px">
        <content>
            <f:SimpleForm id="_IDGenSimpleForm" layout="ColumnLayout" editable="true">
                <!-- Chọn Sản Phẩm -->
                <Label id="_IDGenLabel2" text="Sản phẩm" required="true" />
                <ComboBox id="_IDGenComboBox" 
                    selectedKey="{newOrder>/product_ID}" 
                    items="{path: '/Products'}"
                    placeholder="Chọn sản phẩm...">
                    <core:Item id="_IDGenItem5" key="{ID}" text="{name}" />
                </ComboBox>

                <!-- Chọn Khách Hàng -->
                <Label id="_IDGenLabel3" text="Khách hàng" required="true" />
                <ComboBox id="_IDGenComboBox3" 
                    selectedKey="{newOrder>/customer_ID}" 
                    items="{path: '/Customers'}"
                    placeholder="Chọn khách hàng...">
                    <core:Item id="_IDGenItem6" key="{ID}" text="{name}" />
                </ComboBox>
            </f:SimpleForm>
        </content>
        <beginButton>
            <Button id="_IDGenButton3" text="Lưu" type="Emphasized" press=".onSaveNewOrder" />
        </beginButton>
        <endButton>
            <Button id="_IDGenButton4" text="Hủy" press=".onCloseDialog" />
        </endButton>
    </Dialog>
</core:FragmentDefinition>