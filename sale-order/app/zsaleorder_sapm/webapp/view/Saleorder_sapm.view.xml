<mvc:View controllerName="zsaleordersapm.controller.Saleorder_sapm"
	xmlns:mvc="sap.ui.core.mvc"
	xmlns:core="sap.ui.core"
	xmlns:p="sap.m.plugins"
	xmlns="sap.m">
	<Table id="idProductsTable" inset="false" items="{
			path: '/Orders',
            parameters: {
              $expand: 'items($expand=product),customer'}
		}">
		<headerToolbar>
			<OverflowToolbar id="_IDGenOverflowToolbar">
				<content>
					<Title id="_IDGenTitle" text="Products" level="H2"/>
					<ToolbarSpacer id="_IDGenToolbarSpacer" />
					<Button id="_IDGenButton1" text="Create Order" icon="sap-icon://add" type="Emphasized" press=".onCreateOrder"/>
                    <Button id="_IDGenButton2" text="Refresh" icon="sap-icon://refresh" press=".onRefresh"/>
					<ComboBox id="idPopinLayout" placeholder="Popin layout options" change=".onPopinLayoutChanged">
						<items>
							<core:Item id="_IDGenItem" text="Block" key="Block"/>
							<core:Item id="_IDGenItem1" text="Grid Large" key="GridLarge"/>
							<core:Item id="_IDGenItem2" text="Grid Small" key="GridSmall"/>
						</items>
					</ComboBox>
					<Label id="_IDGenLabel" text="Sticky options:" />
					<CheckBox id="_IDGenCheckBox" text="ColumnHeaders" select=".onSelect"/>
					<CheckBox id="_IDGenCheckBox1" text="HeaderToolbar" select=".onSelect"/>
					<CheckBox id="_IDGenCheckBox2" text="InfoToolbar" select=".onSelect"/>
					<ToggleButton id="toggleInfoToolbar" text="Hide/Show InfoToolbar" press=".onToggleInfoToolbar" />
				</content>
			</OverflowToolbar>
		</headerToolbar>
		<infoToolbar>
			<OverflowToolbar id="_IDGenOverflowToolbar1">
				<Label id="_IDGenLabel1" text="Wide range of available products"/>
			</OverflowToolbar>
		</infoToolbar>
		<columns>
		<Column id="_IDGenColumn6"
				width="15em" hAlign="Center">
						<Text id="_IDGenText" text="Order ID" />
				<dependents>
					<p:ColumnAIAction id="_IDGenColumnAIAction" press=".onAIActionPress"></p:ColumnAIAction>
				</dependents>
			</Column>
			<Column id="_IDGenColumn1" minScreenWidth="Tablet" demandPopin="true">
				<Text id="_IDGenText1" text="Product Name" />
			</Column>
			<Column id="_IDGenColumn2" minScreenWidth="Desktop" demandPopin="true" hAlign="Begin">
				<Text id="_IDGenText2" text="Customer Name" />
			</Column>
			<Column id="_IDGenColumn3" minScreenWidth="Desktop" demandPopin="true" hAlign="Center">
				<Text id="_IDGenText3" text="Order Date" />
			</Column>
			<Column id="_IDGenColumn4" hAlign="End">
				<Text id="_IDGenText4" text="Created At" />
			</Column>
		</columns>
		<items>
			<ColumnListItem id="_IDGenColumnListItem" vAlign="Middle">
				<cells>
					<ObjectIdentifier id="_IDGenObjectIdentifier" title="{ID}"/>
					<Text id="_IDGenText5" text="{items/product/name}" />
					<Text id="_IDGenText6" text="{customer/name}" />
					<Text id="_IDGenText7" text="{orderDate}" />
					<Text id="_IDGenText8" text="{createdAt}" />
				</cells>
			</ColumnListItem>
		</items>
	</Table>
</mvc:View>