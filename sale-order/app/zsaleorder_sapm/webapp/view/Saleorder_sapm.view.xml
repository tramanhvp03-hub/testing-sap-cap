<mvc:View controllerName="zsaleordersapm.controller.Saleorder_sapm"
	xmlns:mvc="sap.ui.core.mvc"
	xmlns:core="sap.ui.core"
	xmlns:p="sap.m.plugins"
	xmlns="sap.m"
	xmlns:f="sap.f"
	xmlns:layout="sap.ui.layout" height="100%">
	<f:DynamicPage id="dynamicPageId" stickySubheaderProvider="iconTabBar" class="sapUiNoContentPadding" toggleHeaderOnTitleClick="true">
		<!-- DynamicPage Title -->
		<f:title>
			<f:DynamicPageTitle id="_IDGenDynamicPageTitle">
				<f:heading>
					<Title id="_IDGenTitle1" text="Sale Order"/>
				</f:heading>
				<f:actions>
					<Button id="_IDGenButton" text="New Order" press="onCreate" type="Ghost" icon="sap-icon://add" visible="{= !${ui>/editable} }"/>
					<Button id="_IDGenButton1" text="Edit" visible="{=!${ui>/editable} }" press="onEdit" type="Emphasized"/>
					<Button id="_IDGenButton6" text="Save" visible="{ui>/editable}" press="onSave" type="Emphasized"/>
					<Button id="_IDGenButton7" text="Cancel" visible="{ui>/editable}" press="onCancel" type="Reject"/>
				</f:actions>
			</f:DynamicPageTitle>
		</f:title>
		<!-- DynamicPage Header -->
		<f:content>
			<IconTabBar id="iconTabBar" class="sapUiResponsiveContentPadding">

				<items>
					<IconTabFilter id="_IDGenIconTabFilter" text="Orders">
						<Table id="idProductsTable" inset="false" mode="SingleSelectMaster" items="{
			path: '/Orders',
            parameters: {
              $expand: 'items($expand=product),customer',
			  $$updateGroupId: 'mySaveGroup'}
		}">
							<headerToolbar>
								<OverflowToolbar id="_IDGenOverflowToolbar">
									<content>
										<Title id="_IDGenTitle" text="Order Detail" level="H2" />
										<ToolbarSpacer id="_IDGenToolbarSpacer" />
										<Button id="_IDGenButton5" text="Delete" press="onDelete" visible="{= !${ui>/editable} }" type="Reject" icon="sap-icon://delete"/>
										<Button id="_IDGenButton2" text="Refresh" visible="{= !${ui>/editable} }" icon="sap-icon://refresh" press=".onRefreshpress" />
									</content>
								</OverflowToolbar>
							</headerToolbar>

							<columns>
								<Column id="_IDGenColumn6" width="15em" hAlign="Center">
									<Text id="_IDGenText" text="Order ID" />
								</Column>
								<Column id="_IDGenColumn1" minScreenWidth="Tablet" demandPopin="true">
									<Text id="_IDGenText1" text="Product Name" />
								</Column>
								<Column id="_IDGenColumn2" minScreenWidth="Desktop" demandPopin="true" hAlign="Begin">
									<Text id="_IDGenText2" text="Customer Name" />
								</Column>
								<Column id="_IDGenColumn3" minScreenWidth="Desktop" demandPopin="true" hAlign="Center">
									<Text id="_IDGenText3" text="Order Date" />
								</Column>
								<Column id="_IDGenColumn4" hAlign="End">
									<Text id="_IDGenText4" text="Created At" />
								</Column>
							</columns>
							<items>
								<ColumnListItem id="_IDGenColumnListItem" vAlign="Middle" >
									<cells>
										<ObjectIdentifier id="_IDGenObjectIdentifier" title="{ID}" />
										<VBox id="_IDGenVBox6" items="{items}" alignContent="End">
											<Text id="_IDGenText5" text="{product/name}" />
										</VBox>	
										<Input id="_IDGenText6" valueLiveUpdate="true" editable="{ui>/editable}" value="{customer/name}" />
										<DatePicker id="_IDGenText7" editable="{ui>/editable}" dateValue="{orderDate}"  />
										<Text id="_IDGenText8" text="{createdAt}" />
									</cells>
								</ColumnListItem>
							</items>
						</Table>
					</IconTabFilter>

					<IconTabFilter id="_IDGenIconTabFilter1" text="Product Info">
						<Table id="idProductsTable2" inset="false" items="{
			path: '/Orders',
            parameters: {
              $expand: 'items($expand=product),customer',
			  $$updateGroupId: 'mySaveGroup'}
		}">
							<headerToolbar>
								<OverflowToolbar id="_IDGenOverflowToolbar3">
									<content>
										<Title id="_IDGenTitle3" text="Product Information" level="H2"/>
										<ToolbarSpacer id="_IDGenToolbarSpacer2" />
										<Button id="_IDGenButton14" text="Refresh" visible="{= !${ui>/editable} }" icon="sap-icon://refresh" press=".onRefreshpress"/>
									</content>
								</OverflowToolbar>
							</headerToolbar>
							<columns>
								<Column id="_IDGenColumn13" minScreenWidth="Tablet" demandPopin="true" hAlign="Center">
									<Text id="_IDGenText13" text="Product ID" />
								</Column>
								<Column id="_IDGenColumn15" minScreenWidth="Desktop" demandPopin="true" hAlign="Begin">
									<Text id="_IDGenText19" text="Product Name" />
								</Column>
								<Column id="_IDGenColumn16" hAlign="Begin">
									<Text id="_IDGenText18" text="Price" />
								</Column>
								<Column id="_IDGenColumn17" hAlign="Begin">
									<Text id="_IDGenText23" text="Stock" />
								</Column>
							</columns>
							<items>
								<ColumnListItem id="_IDGenColumnListItem2" vAlign="Middle">
									<cells>
									<VBox id="_IDGenVBox3" items="{items}">
										<Text id="_IDGenText20" text="{product/ID}" />
										</VBox>	
										<VBox id="_IDGenVBox" items="{items}">
											<Text id="_IDGenText21" text="{product/name}" />
										</VBox>	
										<VBox id="_IDGenVBox4" items="{items}">	
										<Input id="_IDGenText22" valueLiveUpdate="true" editable="{ui>/editable}" value="{product/price}" />
										</VBox>	
										<VBox id="_IDGenVBox2" items="{items}">
										<Input id="_IDGenText24" valueLiveUpdate="true" editable="{ui>/editable}" value="{product/stock}" />
										</VBox>	
									</cells>
								</ColumnListItem>
							</items>
						</Table>
					</IconTabFilter>

					<IconTabFilter id="_IDGenIconTabFilte2" text="Customer Info">
						<Table id="idProductsTable1" inset="false" items="{
			path: '/Orders',
            parameters: {
              $expand: 'items($expand=product),customer',
			  $$updateGroupId: 'mySaveGroup'}
		}">
							<headerToolbar>
								<OverflowToolbar id="_IDGenOverflowToolbar2">
									<content>
										<Title id="_IDGenTitle2" text="Customer Infomation" level="H2"/>
										<ToolbarSpacer id="_IDGenToolbarSpacer1" />
										<Button id="_IDGenButton12" text="Refresh" visible="{= !${ui>/editable} }" icon="sap-icon://refresh" press=".onRefreshpress"/>
									</content>
								</OverflowToolbar>
							</headerToolbar>
							<columns>
								<Column id="_IDGenColumn11" minScreenWidth="Tablet" demandPopin="true" hAlign="Center">
									<Text id="_IDGenText11" text="Customer ID" />
								</Column>
								<Column id="_IDGenColumn12" minScreenWidth="Desktop" demandPopin="true" hAlign="Begin">
									<Text id="_IDGenText12" text="Customer Name" />
								</Column>
								<Column id="_IDGenColumn14" hAlign="Begin">
									<Text id="_IDGenText14" text="Email" />
								</Column>
							</columns>
							<items>
								<ColumnListItem id="_IDGenColumnListItem1" vAlign="Middle">
									<cells>
										<Text id="_IDGenText15" text="{customer/ID}" />
										<Input id="_IDGenText16" valueLiveUpdate="true" editable="{ui>/editable}" value="{customer/name}" />
										<Input id="_IDGenText17" valueLiveUpdate="true" editable="{ui>/editable}" value="{customer/email}" />
									</cells>
								</ColumnListItem>
							</items>
						</Table>
					</IconTabFilter>
				</items>
			</IconTabBar>
		</f:content>
	</f:DynamicPage>
</mvc:View>