<mvc:View xmlns:table="sap.m.table" id="_IDGenView1" controllerName="zsaleorder.controller.Detailpage"
	xmlns:mvc="sap.ui.core.mvc"
	xmlns="sap.uxap"
	xmlns:layout="sap.ui.layout"
	xmlns:m="sap.m"
	xmlns:personal="zsaleorder.SharedBlocks.personal"
	xmlns:product="zsaleorder.SharedBlocks.product" height="100%">

	<ObjectPageLayout id="ObjectPageLayout" enableLazyLoading="true" useIconTabBar="true" showTitleInHeaderContent="true" upperCaseAnchorBar="false">
		<headerTitle>
			<ObjectPageDynamicHeaderTitle id="_IDGenObjectPageDynamicHeaderTitle1">
				<expandedHeading>
					<m:Title id="_IDGenTitle" text="Order ID: {ID}" wrapping="true"/>
				</expandedHeading>
				<actions>
					<m:Button id="_IDGenButton3" text="New Order" type="Neutral" press=".onAdd" icon="sap-icon://add"/>
					<m:Button id="_IDGenButton1" text="Edit" type="Emphasized" press=".onEdit" icon="sap-icon://edit"/>
					<m:Button id="_IDGenButton2" type="Reject" text="Delete" press=".onDelete" icon="sap-icon://delete"/>
					<m:OverflowToolbarButton id="_IDGenOverflowToolbarButton" icon="sap-icon://action" type="Transparent" text="Share" tooltip="action"/>
				</actions>
			</ObjectPageDynamicHeaderTitle>
		</headerTitle>

		<sections>
			<ObjectPageSection titleUppercase="false" id="product" title="Order Detail">
				<subSections>
					<ObjectPageSubSection id="productSS1" title="Item" titleUppercase="false">
						<blocks>
							<product:BlockItemDetailPart1 id="itemdetailpart1"/>
						</blocks>
					</ObjectPageSubSection>

					<ObjectPageSubSection id="productSS2" title="Product" titleUppercase="false">
						<blocks>
							<product:BlockProDetailPart1 id="productdetailpart1" columnLayout="1"/>
						</blocks>
					</ObjectPageSubSection>

				</subSections>
			</ObjectPageSection>

			<ObjectPageSection titleUppercase="false" id="personal" title="Customer Info">
				<subSections>
					<ObjectPageSubSection id="personalSS1" title="Customer Info" titleUppercase="false">
						<blocks>
							<personal:BlockPersInfo id="persinfo"/>
							<personal:BlockContact id="contact"/>
						</blocks>
					</ObjectPageSubSection>
				</subSections>
			</ObjectPageSection>


		</sections>
	</ObjectPageLayout>
</mvc:View>
