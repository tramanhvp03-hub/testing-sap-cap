<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core">
    
    <Dialog 
        id="createSaleOrderDialog" 
        title="New Sale Order" 
        contentWidth="800px" 
        contentHeight="500px">
        
        <content>
            <VBox id="_IDGenVBox1" class="sapUiSmallMargin">
                <Label id="_IDGenLabel8" text="Customer Name" required="true" />
                <Input id="_IDGenInput4" value="{newOrder>/customer/name}" placeholder="Enter Customer Name" />

                <Label id="_IDGenLabel10" text="Order Date" class="sapUiSmallMarginTop" />
                <DatePicker id="_IDGenDatePicker" 
                    value="{newOrder>/orderDate}" 
                    valueFormat="yyyy-MM-dd" 
                    displayFormat="dd/MM/yyyy" 
                    placeholder="Select Date" />

                <Toolbar id="_IDGenToolbar" class="sapUiSmallMarginTop">
                    <Title id="_IDGenTitle4" text="Product List" />
                    <ToolbarSpacer id="_IDGenToolbarSpacer1" />
                    <Button id="_IDGenButton6" icon="sap-icon://add" press=".onAddProductRow" tooltip="Add Product Row" />
                </Toolbar>

                <Table id="addProductsTable" items="{newOrder>/items}">
                    <columns>
                        <Column id="_IDGenColumn8" width="150px"><Text id="_IDGenText25" text="Product" /></Column>
                        <Column id="_IDGenColumn17" width="150px"><Text id="_IDGenText27" text="Quantity" /></Column>
                        <Column id="_IDGenColumn18" width="150px"><Text id="_IDGenText28" text="Price" /></Column>
                        <Column id="_IDGenColumn19" width="50px"  />
                    </columns>
                    <items>
                        <ColumnListItem id="_IDGenColumnListItem4">
                            <cells>
                                <!-- Multi-column layout trong ComboBox sử dụng ListItem -->
                                <ComboBox id="_IDGenComboBox" 
                                    selectedKey="{newOrder>product_ID}" 
                                    items="{path: '/Products'}"
                                    selectionChange=".onProductSelectionChange">
                                    <core:ListItem id="_IDGenListItem" key="{ID}" text="{name}" additionalText="{price}" />
                                </ComboBox>
                                
                                <Input id="_IDGenInput5" value="{newOrder>quantity}" type="Number" placeholder="Quantity" />
                                <Input id="_IDGenInput6" value="{newOrder>price}" type="Number" placeholder="Price" />
                                
                                <Button id="_IDGenButton7" 
                                    icon="sap-icon://delete" 
                                    type="Transparent" 
                                    press=".onDeleteProductRow" />
                            </cells>
                        </ColumnListItem>
                    </items>
                </Table>
            </VBox>
        </content>

        <beginButton>
            <Button id="_IDGenButton8" text="Save" type="Emphasized" press=".onSaveSaleOrder" />
        </beginButton>

        <endButton>
            <Button id="_IDGenButton9" text="Cancel" press=".onCloseCreateDialog" />
        </endButton>

    </Dialog>
</core:FragmentDefinition>