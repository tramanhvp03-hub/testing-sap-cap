<mvc:View controllerName="zsaleorder.controller.Saleorder"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:core="sap.ui.core"
    xmlns="sap.m"
    xmlns:f="sap.f"
    xmlns:fb="sap.ui.comp.filterbar"
    xmlns:form="sap.ui.layout.form"
    xmlns:svm="sap.ui.comp.smartvariants">
    <f:DynamicPage id="_IDGenDynamicPage1" title="{i18n>title}" headerExpanded="true">
        <f:title>
            <f:DynamicPageTitle id="_IDGenDynamicPageTitle">
                <f:heading>
                    <svm:SmartVariantManagement id="svm" showExecuteOnSelection="false" showShare="false" />
                </f:heading>
                <f:expandedContent>
                    <Label id="_IDGenLabel5" text="No filters active" />
                </f:expandedContent>
                <f:snappedContent>
                    <Label id="_IDGenLabel6" text="No filters active" />
                </f:snappedContent>
            </f:DynamicPageTitle>
        </f:title>

        <f:header>
            <f:DynamicPageHeader id="_IDGenDynamicPageHeader">
                <f:content>
                    <fb:FilterBar id="filterbar" useToolbar="true" search=".onSearch" filterChange=".onFilterChange" showFilterConfiguration="false" afterVariantLoad=".onAfterVariantLoad">
                        <fb:filterGroupItems>
                            <fb:FilterGroupItem id="_IDGenFilterGroupItem" name="Product Name" label="Product Name" groupName="Default" visibleInFilterBar="true">
                                <fb:control>
                                    <MultiComboBox id="_IDGenMultiComboBox" name="Product Name" selectionChange=".onSelectionChange" items="{
												path: '/Products'						
											}">
                                        <core:Item id="_IDGenItem" key="{ID}" text="{name}" />
                                    </MultiComboBox>
                                </fb:control>
                            </fb:FilterGroupItem>

                            <fb:FilterGroupItem id="_IDGenFilterGroupItem1" name="Customer Name" label="Customer Name" groupName="Default" visibleInFilterBar="true">
                                <fb:control>
                                    <MultiInput id="multiInput" name="Customer Name" width="60%" valueHelpRequest=".onValueHelpRequested" suggestionRows="{
                                                    path: '/Customers',
                                                    length: 10
                                                }">
                                        <suggestionColumns>
                                            <Column id="_IDGenColumn4">
                                                <Label id="_IDGenLabel1" text="Customer ID" />
                                            </Column>
                                            <Column id="_IDGenColumn5">
                                                <Label id="_IDGenLabel2" text="Customer Name" />
                                            </Column>
                                        </suggestionColumns>
                                        <suggestionRows>
                                            <ColumnListItem id="_IDGenColumnListItem1">
                                                <Label id="_IDGenLabel3" text="{ID}" />
                                                <Label id="_IDGenLabel4" text="{name}" />
                                            </ColumnListItem>
                                        </suggestionRows>
                                    </MultiInput>
                                </fb:control>
                            </fb:FilterGroupItem>

                            <fb:FilterGroupItem id="_IDGenFilterGroupItem3" name="Order Date" label="Order Date" groupName="Default" visibleInFilterBar="true">
                                <fb:control>
                                    <DatePicker id="DP1" name="Order Date" value="{path: 'orderDate'}" valueFormat="yyyy-MM-dd" displayFormat="dd-MM-yyy" placeholder="Enter Date" />
                                </fb:control>
                            </fb:FilterGroupItem>

                            <!-- <fb:FilterGroupItem id="_IDGenFilterGroupItem6" name="button"  groupName="Default" visibleInFilterBar="true">
                                <fb:control>
                                    <Button id="_IDGenButton3" text="Add Item" type="Neutral" width="10%" press=".onAdd" icon="sap-icon://add"/>
                                </fb:control>
                            </fb:FilterGroupItem> -->

                        </fb:filterGroupItems>
                    </fb:FilterBar>
                </f:content>
            </f:DynamicPageHeader>
        </f:header>

        <f:content>
            <Table id="table" itemPress="onNavigate" items="{
						path: '/Orders',
                        parameters: {
                              $expand: 'items($expand=product),customer'
        }
					}">
                <columns>
                    <Column id="_IDGenColumn" minScreenWidth="Tablet" demandPopin="true">
                        <Text id="_IDGenText" text="Order ID" />
                    </Column>
                    <Column id="_IDGenColumn1" minScreenWidth="Tablet" demandPopin="true">
                        <Text id="_IDGenText1" text="Customer Name" />
                    </Column>
                    <Column id="_IDGenColumn2" minScreenWidth="Tablet" demandPopin="true">
                        <Text id="_IDGenText2" text="Product Name" />
                    </Column>
                    <Column id="_IDGenColumn3" minScreenWidth="Tablet" demandPopin="true">
                        <Text id="_IDGenText6" text="Order Date" />
                    </Column>
                    <Column id="_IDGenColumn7">
                        <Text id="_IDGenText8" />
                    </Column>
                </columns>

                <items>
                    <ColumnListItem id="_IDGenColumnListItem" vAlign="Middle">
                        <cells>
                            <ObjectIdentifier id="_IDGenObjectIdentifier" title="{ID}" />
                            <Text id="_IDGenText3" text="{customer/name}" />
                            <Text id="_IDGenText4" text="{items/product/name}" />
                            <Text id="_IDGenText5" text="{path: 'orderDate', formatter: '.formatOrderDate'}"/>
                            <Button id="_IDGenButton" icon="sap-icon://feeder-arrow" press="onNavigate" />
                        </cells>
                    </ColumnListItem>
                </items>
            </Table>
        </f:content>
    </f:DynamicPage>
</mvc:View>
