<mvc:View controllerName="zsaleorder.controller.Saleorder"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:core="sap.ui.core"
    xmlns="sap.m"
    xmlns:f="sap.f"
    xmlns:fb="sap.ui.comp.filterbar"
    xmlns:form="sap.ui.layout.form"
    xmlns:svm="sap.ui.comp.smartvariants">
    <f:DynamicPage id="_IDGenDynamicPage1" title="{i18n>title}" headerExpanded="true" fitContent="true">
        <f:title>
            <f:DynamicPageTitle id="_IDGenDynamicPageTitle">
                <f:heading>
                    <svm:SmartVariantManagement id="svm" showExecuteOnSelection="false" showShare="false" />
                </f:heading>
                <f:expandedContent>
                    <Label id="_IDGenLabel5" text="No filters active" />
                </f:expandedContent>
                <f:snappedContent>
                    <Label id="_IDGenLabel6" text="No filters active" />
                </f:snappedContent>
            </f:DynamicPageTitle>
        </f:title>

        <f:header>
            <f:DynamicPageHeader id="_IDGenDynamicPageHeader">
                <f:content>
                    <fb:FilterBar id="filterbar" useToolbar="false" search=".onSearch" filterChange=".onFilterChange" showFilterConfiguration="false" afterVariantLoad=".onAfterVariantLoad">
                        <fb:filterGroupItems>
                            <fb:FilterGroupItem id="_IDGenFilterGroupItem" name="Product Name" label="Product Name" groupName="Default" visibleInFilterBar="true">
                                <fb:control>
                                    <MultiComboBox id="_IDGenMultiComboBox" name="Product Name" selectionChange=".onSelectionChange" items="{
												path: '/Products'						
											}">
                                        <core:Item id="_IDGenItem" key="{ID}" text="{name}" />
                                    </MultiComboBox>
                                </fb:control>
                            </fb:FilterGroupItem>

                            <fb:FilterGroupItem id="_IDGenFilterGroupItem1" name="Customer Name" label="Customer Name" groupName="Default" visibleInFilterBar="true">
                                <fb:control>
                                    <MultiInput id="multiInput" name="Customer Name" width="60%" valueHelpRequest=".onValueHelpRequested" suggestionRows="{
                                                    path: '/Customers',
                                                    length: 10
                                                }">
                                        <suggestionColumns>
                                            <Column id="_IDGenColumn4">
                                                <Label id="_IDGenLabel1" text="Customer ID" />
                                            </Column>
                                            <Column id="_IDGenColumn5">
                                                <Label id="_IDGenLabel2" text="Customer Name" />
                                            </Column>
                                        </suggestionColumns>
                                        <suggestionRows>
                                            <ColumnListItem id="_IDGenColumnListItem1">
                                                <Label id="_IDGenLabel3" text="{ID}" />
                                                <Label id="_IDGenLabel4" text="{name}" />
                                            </ColumnListItem>
                                        </suggestionRows>
                                    </MultiInput>
                                </fb:control>
                            </fb:FilterGroupItem>

                            <fb:FilterGroupItem id="_IDGenFilterGroupItem3" name="Order Date" label="Order Date" groupName="Default" visibleInFilterBar="true">
                                <fb:control>
                                    <DatePicker id="DP1" name="Order Date" value="{path: 'orderDate'}" valueFormat="yyyy-MM-dd" displayFormat="dd/MM/yyyy" placeholder="Enter Date" />
                                </fb:control>
                            </fb:FilterGroupItem>

                        </fb:filterGroupItems>
                    </fb:FilterBar>
                </f:content>
            </f:DynamicPageHeader>
        </f:header>

        <f:content>
       
            <Table id="table" itemPress="onNavigate" mode="SingleSelectLeft" growingThreshold="10" items="{
						path: '/Orders',
                        parameters: {
                              $expand: 'items($expand=product),customer'
        }
					}">
                <headerToolbar>
                    <Toolbar id="_IDGenToolbar1" design="Solid">
                        <Title id="_IDGenTitle3" text="Sale Orders" />
                        <ToolbarSpacer id="_IDGenToolbarSpacer"/>
                        <Button id="_IDGenButton4" text="New Order" icon="sap-icon://add" type="Neutral" press=".onAdd"/>
                        <Button id="_IDGenButton5" text="Delete Selected" icon="sap-icon://delete" type="Reject" press=".onDelete"/>
                    </Toolbar>
                </headerToolbar>
                <columns>
                    <Column id="_IDGenColumn" width="16%" hAlign="Center" minScreenWidth="Tablet" demandPopin="false">
                        <Text id="_IDGenText1" text="Order ID"/>
                    </Column>
                    <Column id="_IDGenColumn1" width="22%" minScreenWidth="Tablet" demandPopin="false">
                        <Text id="_IDGenText2" text="Customer Name"/>
                    </Column>
                    <Column id="_IDGenColumn2" width="33%" minScreenWidth="Tablet" demandPopin="false">
                        <Text id="_IDGenText6" text="Product Name"/>
                    </Column>
                    <Column id="_IDGenColumn3" width="20%" minScreenWidth="Tablet" demandPopin="false">
                        <Text id="_IDGenText8" text="Order Date"/>
                    </Column>
                    <Column id="_IDGenColumn6" width="28%" minScreenWidth="Tablet" demandPopin="false">
                        <Text id="_IDGenText11" text="Created At"/>
                    </Column>
                    <Column id="_IDGenColumn7" width="6%">
                        <Text id="_IDGenText12"/>
                    </Column>
                </columns>

                <items>
                    <ColumnListItem id="_IDGenColumnListItem" vAlign="Middle">
                        <cells>
                            <ObjectIdentifier id="_IDGenObjectIdentifier" title="{ID}" />
                            <Text id="_IDGenText3" text="{customer/name}" />
                            <Text id="_IDGenText4" text="{items/product/name}" />
                            <Text id="_IDGenText5" text="{path: 'orderDate', formatter: '.formatOrderDate'}"/>
                            <Text id="_IDGenText10" text="{path: 'createdAt', formatter: '.formatCreatedAt'}"/>
                            <HBox id="_IDGenHBox1" justifyContent="End">
                                <Button id="_IDGenButton" icon="sap-icon://feeder-arrow" press=".onNavigate" type="Transparent"/>
                            </HBox>
                        </cells>
                    </ColumnListItem>
                </items>
            </Table>
        </f:content>
    </f:DynamicPage>
</mvc:View>
