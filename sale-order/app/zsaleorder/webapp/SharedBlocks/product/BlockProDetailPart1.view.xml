<mvc:View xmlns:mvc="sap.ui.core.mvc" xmlns:core="sap.ui.core"
		  xmlns:forms="sap.ui.layout.form" xmlns="sap.m" height="100%">

	<Table id="itemsTable2" items="{items}" width="100%">
        <columns>
            <Column id="_IDGenColumn13" ><Text id="_IDGenText18" text="Product ID" /></Column>
            <Column id="_IDGenColumn14" ><Text id="_IDGenText21" text="Product Name" /></Column>
            <Column id="_IDGenColumn15" ><Text id="_IDGenText22" text="Price" /></Column>
            <Column id="_IDGenColumn16" ><Text id="_IDGenText23" text="Stock" /></Column>
        </columns>
        <items>
            <ColumnListItem id="_IDGenColumnListItem3" >
                <cells>
                    <Text id="_IDGenText24" text="{product/ID}" />
                    <Text id="_IDGenInput3" text="{product/name}" />
                    <Text id="_IDGenText26" text="{product/price}" />
                    <Input id="_IDGenText29" value="{
                                                        path: 'product/stock',
                                                        type: 'sap.ui.model.type.Integer'
                                                    }" 
                                            editable="{ui>/editable}" />
                </cells>
            </ColumnListItem>
        </items>
    </Table>
</mvc:View>
