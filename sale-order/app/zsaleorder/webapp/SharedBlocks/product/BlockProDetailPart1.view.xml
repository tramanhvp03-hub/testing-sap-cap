<mvc:View xmlns:mvc="sap.ui.core.mvc"
    xmlns:core="sap.ui.core"
    xmlns:forms="sap.ui.layout.form"
    xmlns="sap.m" height="100%">

    <Table id="itemsTable2" items="{items}" width="100%">
        <columns>
            <Column id="_IDGenColumn13">
                <Text id="_IDGenText18" text="Product ID" />
            </Column>
            <Column id="_IDGenColumn14">
                <Text id="_IDGenText21" text="Product Name" />
            </Column>
            <Column id="_IDGenColumn15">
                <Text id="_IDGenText22" text="Price" />
            </Column>
            <Column id="_IDGenColumn16">
                <Text id="_IDGenText23" text="Stock" />
            </Column>
        </columns>
        <items>
            <ColumnListItem id="_IDGenColumnListItem3">
                <cells>
                    <Text id="_IDGenText24" text="{product/ID}" />
                    <Text id="_IDGenInput3" text="{product/name}" />
                    <Text id="_IDGenText26" text="{product/price}" />
                    <VBox id="_IDGenStockCell">
                        <ObjectStatus id="_IDGenObjectStatus1" visible="{= !${ui>/editable} }" text="{product/stock}" state="{= ${product/stock} &lt; 5 ? 'Error' : (${product/stock} &lt; 10 ? 'Warning' : 'Success') }" icon="{= ${product/stock} &lt; 5 ? 'sap-icon://alert' : (${product/stock} &lt; 10 ? 'sap-icon://message-warning' : 'sap-icon://sys-enter-2') }" />
                        <HBox id="_IDGenHBox" alignItems="Center" visible="{ui>/editable}">
                            <core:Icon id="_IDGenIcon" src="{= ${product/stock} &lt; 5 ? 'sap-icon://alert' : (${product/stock} &lt; 10 ? 'sap-icon://message-warning' : 'sap-icon://sys-enter-2') }" color="{= ${product/stock} &lt; 5 ? 'Negative' : (${product/stock} &lt; 10 ? 'Critical' : 'Positive') }" class="sapUiTinyMarginEnd" />
                            <Input id="_IDGenInput7" 
                                    value="{
                                        path: 'product/stock',
                                        type: 'sap.ui.model.type.Integer'
                                    }" 
                                    valueState="{= ${product/stock} &lt; 5 ? 'Error' : (${product/stock} &lt; 10 ? 'Warning' : 'Success') }" />
                        </HBox>
                    </VBox>
                </cells>
            </ColumnListItem>
        </items>
    </Table>
</mvc:View>
