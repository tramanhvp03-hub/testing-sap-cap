<mvc:View xmlns:mvc="sap.ui.core.mvc" xmlns:core="sap.ui.core"
		  xmlns:forms="sap.ui.layout.form" xmlns="sap.m">

	<forms:SimpleForm id="_IDGenSimpleForm5" labelSpanL="4" labelSpanM="4" editable="false"
					  labelSpanS="4" emptySpanL="0" emptySpanM="0" emptySpanS="0"
					  maxContainerCols="2" layout="ResponsiveGridLayout"
					  width="100%">
		<Label id="_IDGenLabel26" text="Product ID"/>
		<Text id="_IDGenText27" text="{items/product/ID}"/>

		<Label id="_IDGenLabel24" text="Name"/>
		<Text id="_IDGenText25" text="{items/product/name}"/>

		<Label id="_IDGenLabel27" text="Price"/>
		<Text id="_IDGenText28" text="{items/product/price}"/>

		<Label id="_IDGenLabel29" text="Stock"/>
		<Input id="_IDGenText30" editable="{ui>/editable}" type="Number" value="{items/product/stock}"/>
	</forms:SimpleForm>
</mvc:View>
