<mvc:View xmlns:mvc="sap.ui.core.mvc"
    xmlns:forms="sap.ui.layout.form"
    xmlns="sap.m"
    xmlns:core="sap.ui.core" 
    controllerName="zsaleorder.controller.Detailpage"
    core:require="{ formatter: 'zsaleorder/model/formatter' }">
    <Table id="itemsTable" items="{items}">
        <columns>
            <Column id="_IDGenColumn9">
                <Text id="_IDGenText4" text="Product Name" />
            </Column>
            <Column id="_IDGenColumn10">
                <Text id="_IDGenText7" text="Quantity" />
            </Column>
            <Column id="_IDGenColumn11">
                <Text id="_IDGenText13" text="Price" />
            </Column>
            <Column id="_IDGenColumn12">
                <Text id="_IDGenText14" text="Amount" />
            </Column>
             <Column id="_IDGenColumn21">
                <Text id="_IDGenText40" text="Created At" />
            </Column>
            <Column id="colAction" hAlign="End">
                <Text id="_IDGenText30" text="Action" />
            </Column>
        </columns>
        <items>
            <ColumnListItem id="_IDGenColumnListItem2">
                <cells>
                    <Text id="_IDGenText15" text="{product/name}" />
                    <Input id="_IDGenInput2" value="{path: 'quantity',
                                                     type: 'sap.ui.model.type.Integer'
                                                    }"
                                             editable="{ui>/editable}" />
                    <Text id="_IDGenText16" text="{product/price}" />
                    <Text id="_IDGenText17" text="{amount}"/>
            		<Text id="_IDGenText32"
			text="{path: 'createdAt', formatter: 'formatter.formatCreatedAt'}"/>
                    <Button id="btnDeleteItem" 
                            type="Reject" 
                            icon="sap-icon://delete" 
                            press=".onDeleteItem" 
                            visible="{= !${ui>/editable}}" />
                </cells>
            </ColumnListItem>
        </items>
    </Table>
</mvc:View>