		<Label id="_IDGenLabel17"  text="ID"/>
		<Text id="_IDGenText7"  text="{items/ID}"/>

		<Label id="_IDGenLabel18" text="Quantity"/>
		<Text id="_IDGenText21"  text="{items/quantity}"/>

		<Label id="_IDGenLabel19"  text="Amount"/>
		<Text id="_IDGenText23"  text="{items/amount}"/>

		<Label id="_IDGenLabel20" text="Created At"/>
