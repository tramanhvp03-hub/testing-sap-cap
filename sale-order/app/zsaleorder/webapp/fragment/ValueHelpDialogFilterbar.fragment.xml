<core:FragmentDefinition
	xmlns="sap.ui.comp.valuehelpdialog"
	xmlns:m="sap.m"
	xmlns:fb="sap.ui.comp.filterbar"
	xmlns:core="sap.ui.core">
	<ValueHelpDialog id="_IDGenValueHelpDialog"
		title="Sale Order"
		ok=".onValueHelpOkPress"
		cancel=".onValueHelpCancelPress"
		afterClose=".onValueHelpAfterClose"
		supportRanges="true"
		key="CustomerID"
		descriptionKey="CustomerName">
		<filterBar>
			<fb:FilterBar id="_IDGenFilterBar" advancedMode="true" search=".onFilterBarSearch" isRunningInValueHelpDialog="true">
				<fb:filterGroupItems>
					<fb:FilterGroupItem id="_IDGenFilterGroupItem4"
						groupName="__$INTERNAL$"
						name="CustomerID"
						label="Customer ID"
						visibleInFilterBar="true">
						<fb:control>
							<m:Input id="_IDGenInput" name="ID" />
						</fb:control>
					</fb:FilterGroupItem>
					<fb:FilterGroupItem id="_IDGenFilterGroupItem5"
						groupName="__$INTERNAL$"
						name="CustomerName"
						label="Customer Name"
						visibleInFilterBar="true">
						<fb:control>
							<m:Input id="_IDGenInput1" name="name" />
						</fb:control>
					</fb:FilterGroupItem>
				</fb:filterGroupItems>
			</fb:FilterBar>
		</filterBar>
	</ValueHelpDialog>
</core:FragmentDefinition>
